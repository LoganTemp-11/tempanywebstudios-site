# Cloudflare Pages response headers.
#
# Fonts and images only ever change by getting a new filename, and the engine
# files carry a ?v= query that is bumped on every edit, so all of them can be
# cached hard. HTML stays on Cloudflare's default (revalidate every visit) so
# a deploy shows up immediately.
#
# The Link header on the homepage is turned into a 103 Early Hints response
# by Cloudflare, so the browser starts fetching the two render-blocking
# stylesheets before the HTML has finished arriving.

# Security headers on every response. No script-src: the pages carry inline
# scripts and styles by design, so a nonce CSP is not practical yet. The
# frame-ancestors, object-src, base-uri and form-action directives still
# earn their keep; the only form target off this origin is Web3Forms.
/*
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self' https://api.web3forms.com; upgrade-insecure-requests

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/images/*
  Cache-Control: public, max-age=2592000

/scrollcraft.min.js
  Cache-Control: public, max-age=604800

/scrollcraft.min.css
  Cache-Control: public, max-age=604800

/fonts.css
  Cache-Control: public, max-age=604800

/tw-base.css
  Cache-Control: public, max-age=604800

/tw-pages.css
  Cache-Control: public, max-age=604800

/tw-page.js
  Cache-Control: public, max-age=604800

# The cookie choice and Google tag script holds the Google Ads slots. Revalidated on
# every visit, so filling them is one edit and one push.
/tw-consent.js
  Cache-Control: public, max-age=0, must-revalidate

/
  Link: </scrollcraft.min.css?v=3>; rel=preload; as=style, </fonts.css?v=2>; rel=preload; as=style, </tw-base.css?v=1>; rel=preload; as=style
